{
	# rate_limit comes from github.com/mholt/caddy-ratelimit (built in by Dockerfile.web)
	order rate_limit before basic_auth

	# A browser opening the site by IP address sends no server name, and inside Docker the connection's local
	# address is the container's, so Caddy couldn't pick a certificate: this name's is used then ($LAN_IP when
	# set, else $DOMAIN; Compose fills it in)
	default_sni {$TLS_DEFAULT_SNI:localhost}

	servers :443 {
		# plain http:// typed at the HTTPS port (a non-standard one, like 8443) is redirected, not refused
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

# Serves the web client on $DOMAIN (and on $LAN_IP, for devices that can't resolve the name) with automatic
# HTTPS, forwards /ws to the XMage server and /img to the Scryfall image cache.
{$DOMAIN:localhost} {$LAN_IP} {
	encode zstd gzip

	# Per client address. Caddy trusts no upstream proxies, so {remote_host} is the real peer address.
	# Over the limit: 429 with Retry-After. The server also caps concurrent game connections per address.
	rate_limit {
		zone ws {
			match {
				path /ws*
			}
			key {remote_host}
			events {$WS_RATE_LIMIT:30}
			window {$WS_RATE_WINDOW:1m}
		}
		# Scryfall lookups that may miss the cache (pictures from the CDN are not limited)
		zone img_api {
			match {
				path /img/api/*
			}
			key {remote_host}
			events {$IMG_API_RATE_LIMIT:300}
			window {$IMG_API_RATE_WINDOW:1m}
		}
	}

	# the game connection: WebSocket upgrade to the server's bridge port
	handle /ws* {
		reverse_proxy xmage:17172 {
			# The server limits and logs by client address. It trusts these headers only from the
			# proxy network (XMAGE_TRUSTED_PROXIES). Caddy sets X-Forwarded-For itself and, with no
			# trusted_proxies of its own, replaces whatever the client sent; X-Real-IP is added here.
			header_up X-Real-IP {remote_host}
		}
	}

	# card pictures and Scryfall lookups, cached by the imgcache service (nginx)
	handle /img/* {
		reverse_proxy imgcache:8080
	}

	handle {
		root * /srv
		# hashed assets never change; the app shell always revalidates
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# the service worker and the web manifest keep their names across releases, so browsers must revalidate
		# them to notice an update (browsers also cap a service worker's HTTP caching at a day)
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest {
			Cache-Control "no-cache"
			Content-Type "application/manifest+json"
		}
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Scryfall origins stay allowed for builds without the image proxy (VITE_IMAGE_PROXY unset); the exported
		# link lists also point the card back at upload.wikimedia.org. wss: covers a client built with
		# VITE_MAGE_SERVER_URL pointing at another host.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cards.scryfall.io https://*.scryfall.io https://api.scryfall.com https://c1.scryfall.com https://svgs.scryfall.io https://upload.wikimedia.org; font-src 'self' data:; connect-src 'self' wss: https://api.scryfall.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'"
	}
}

# http:// on the HTTP port goes to HTTPS on the port players actually use (Caddy's own redirect would assume 443,
# which is wrong when HTTPS_PORT maps another host port to it). ACME HTTP challenges are answered before this.
http:// {
	redir https://{host}:{$PUBLIC_HTTPS_PORT:443}{uri} permanent
}
