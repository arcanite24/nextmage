# Copy to ops/web/.env and edit. docker compose reads it automatically.
# Empty values use the defaults listed in ops/web/README.md.

# Public host name; Caddy gets its certificate for it and it is the only allowed browser origin.
DOMAIN=play.example.com
# Optional: the host's LAN address (e.g. 192.168.1.156), also served over HTTPS for devices that can't resolve DOMAIN
# (a .local name on Android, say). Add https://<it>:<HTTPS_PORT> to XMAGE_ALLOWED_ORIGINS too.
LAN_IP=
# Optional: a public name served by another reverse proxy in front (e.g. the host's main Caddy, which holds its
# certificate), proxied to HTTP_PORT here. UPSTREAM_PROXIES is the address range that proxy connects from (on Docker
# Desktop, a container reaching a published port arrives from the bridge gateway, 172.17.0.1/32). Add
# https://<PROXIED_HOST> to XMAGE_ALLOWED_ORIGINS and set XMAGE_PUBLIC_URL to it.
PROXIED_HOST=
UPSTREAM_PROXIES=
# Host ports for Caddy. Change them when another web server already owns 80/443 on the host.
HTTP_PORT=80
HTTPS_PORT=443
# Defaults to https://$DOMAIN. Include the port when HTTPS_PORT is not 443, e.g. https://multivac.local:8443
XMAGE_ALLOWED_ORIGINS=

# --- server -----------------------------------------------------------------------------------
# Admin login (desktop admin console and the bridge). Unset = admin login disabled.
XMAGE_ADMIN_PASSWORD=
# Require registered accounts with passwords. Use true for a public server (and configure mail).
XMAGE_AUTH=false
# Discord channel news: public tables opening, events and matches starting. A secret. Empty = off.
XMAGE_DISCORD_WEBHOOK=
# Staff news: access requests, player reports and staff role changes, kept out of the public channel.
# Empty = they go to XMAGE_DISCORD_WEBHOOK. A secret.
XMAGE_DISCORD_STAFF_WEBHOOK=
# Who may play: open (anyone who registers) or allowlist (a contributors server: only the owner,
# staff and listed or invited accounts). Read on the first boot only; /admin switches it after that.
# allowlist needs XMAGE_AUTH=true.
XMAGE_ACCESS=open
# The owner's account name: always allowed in, whatever the mode, and always an owner in /admin.
XMAGE_OWNER=
# The first boot's allowlist: account names and emails, comma separated, or @/path/in/container to a
# file with one per line. Later changes are made in /admin.
XMAGE_ALLOWLIST=
# Sign in with GitHub: an OAuth app's client id and secret (github.com/settings/developers, callback
# URL <XMAGE_PUBLIC_URL>/auth/github). Empty = off. The secret is a secret.
XMAGE_GITHUB_CLIENT_ID=
XMAGE_GITHUB_CLIENT_SECRET=
# owner/name: the repository's people get in to a contributors server when they sign in with GitHub.
# Its collaborators with XMAGE_GITHUB_TOKEN (a token that can read them), else its public contributors.
XMAGE_GITHUB_REPO=
XMAGE_GITHUB_TOKEN=
# off turns the single-player Career off (it needs accounts either way)
XMAGE_CAREER=on
# Public address of the web client, for join links in Discord posts. Defaults to https://$DOMAIN;
# include the port when HTTPS_PORT is not 443, e.g. https://multivac.local:8443
XMAGE_PUBLIC_URL=
# Product name shown in the web client (a build argument: rebuild the web image after changing it).
APP_NAME=Playmat
XMAGE_SAVE_GAMES=false
# Web client replays of finished games (History screen), kept on the xmage-saved volume.
XMAGE_REPLAYS=true
XMAGE_REPLAY_DAYS=30
XMAGE_REPLAY_MAX=300
# Java heap. Empty: XMAGE_HEAP_PERCENT (40) of the machine's memory, between 256m and 1g, which
# fits anything from a 1 GB VPS up. Set it (e.g. 2g) only to override that.
XMAGE_MEMORY=
# Garbage collector: auto (Serial on 1-2 CPUs, else G1), serial, g1 or parallel.
XMAGE_GC=
# Games and AI players at once. 4 suits 2 vCPU; on a 1 vCPU / 1 GB VPS see small-vps.env.
XMAGE_MAX_GAME_THREADS=4
XMAGE_MAX_AI_OPPONENTS=4
XMAGE_MAX_SECONDS_IDLE=
XMAGE_SERVER_NAME=mage-server
# Only matters for desktop clients (port 17171); public name they connect to.
XMAGE_SERVER_ADDRESS=
XMAGE_JAVA_OPTS=
# Addresses allowed to set X-Forwarded-For. Default: the compose network Caddy runs on.
# Compose network for this stack; Caddy gets a fixed address on it and is the only trusted proxy.
# Change both if the subnet collides with another Docker network on the host.
XMAGE_SUBNET=10.89.17.0/24
CADDY_IP=10.89.17.10
# Defaults to CADDY_IP.
XMAGE_TRUSTED_PROXIES=

# --- mail (needed for registration and password reset when XMAGE_AUTH=true) --------------------
# Either mailgun ...
XMAGE_MAILGUN_API_KEY=
XMAGE_MAILGUN_DOMAIN=
# ... or SMTP (used when XMAGE_MAIL_USER is set)
XMAGE_MAIL_SMTP_HOST=
XMAGE_MAIL_SMTP_PORT=
XMAGE_MAIL_USER=
XMAGE_MAIL_PASSWORD=
XMAGE_MAIL_FROM=

# --- proxy limits (per client address, at Caddy) ----------------------------------------------
# New game connections per window. The server also caps concurrent connections per address (16).
WS_RATE_LIMIT=30
WS_RATE_WINDOW=1m
# Scryfall lookups through the image cache per window (pictures are not limited).
IMG_API_RATE_LIMIT=300
IMG_API_RATE_WINDOW=1m

# --- card image cache (imgcache) --------------------------------------------------------------
IMGCACHE_IMAGES_MAX_SIZE=20g
IMGCACHE_API_MAX_SIZE=1g
# Requests per second to api.scryfall.com for the whole site (cache misses only), and the queue before 429.
IMGCACHE_API_RATE=10r/s
IMGCACHE_API_BURST=20

# --- backups ----------------------------------------------------------------------------------
BACKUP_AT=03:30
BACKUP_KEEP=14
TZ=UTC
