# XMage server with the web bridge (WebSocket JSON-RPC on 17172).
# Build context: the repository root.  docker build -f ops/web/Dockerfile.server .
# The same image runs the nightly backup service (entrypoint xmage-backup).
# The server is built with JDK 17 (for Java 8 bytecode) and runs on JAVA_RUNTIME: 25 by default, where compact object
# headers (JEP 519) shrink every object by 4 bytes; 17 still works (docker build --build-arg JAVA_RUNTIME=17).
ARG JAVA_RUNTIME=25
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY . .
# the full card set build is long (tens of minutes); the maven cache makes rebuilds faster
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -q install -DskipTests \
 && cd Mage.Server && mvn -B -q package assembly:single -DskipTests \
 && mkdir -p /opt/xmage && cd /opt/xmage && jar xf /src/Mage.Server/target/mage-server.zip \
 && date -u +%Y%m%dT%H%M%S%N > /opt/xmage/.build-id
# The card database belongs to the image: build it here (a cold start, about half a minute on a fast machine),
# so a deploy starts warm instead of rebuilding it on the server. The assembly packs whatever Mage.Server/db held
# in the build context, so start from nothing; only the card database is kept.
# A fresh build leaves H2 with about five times the pages it needs (290 MB), so it is compacted (to 53 MB) before it ships.
RUN cd /opt/xmage && rm -rf db saved \
 && java -Dxmage.exitAfterStartup=true -Dxmage.testMode=false -Dxmage.healthPort=0 -Dxmage.replays=false \
      -jar lib/mage-server-*.jar \
 && java -cp "$(ls lib/h2-*.jar | head -n1)" org.h2.tools.Shell -url "jdbc:h2:file:./db/cards.h2" -user "" -password "" \
      -sql "SHUTDOWN COMPACT" \
 && mkdir -p cards-prebuilt && mv db/cards.h2.mv.db cards-prebuilt/ && rm -rf db saved extensions mageserver.log
# the commit the admin console and /healthz report; git itself isn't in this image, so read the ref files
RUN ref=$(sed -n 's/^ref: //p' .git/HEAD 2>/dev/null); \
    { if [ -n "$ref" ] && [ -f ".git/$ref" ]; then cat ".git/$ref"; \
      elif [ -n "$ref" ]; then grep " $ref\$" .git/packed-refs | cut -d' ' -f1; \
      else cat .git/HEAD; fi; } > /opt/xmage/.commit 2>/dev/null || true

FROM eclipse-temurin:${JAVA_RUNTIME}-jre
ARG JAVA_RUNTIME
ENV XMAGE_JAVA_RUNTIME=${JAVA_RUNTIME}
# xmlstarlet renders config.xml at start; sqlite3 takes consistent backups of the stats databases
RUN apt-get update \
 && apt-get install -y --no-install-recommends xmlstarlet sqlite3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/xmage
COPY --from=build /opt/xmage /opt/xmage
COPY ops/web/server-entrypoint.sh /usr/local/bin/xmage-server
COPY ops/web/backup.sh /usr/local/bin/xmage-backup
COPY ops/web/log4j-docker.properties /opt/xmage/config/log4j-docker.properties
# config.template.xml is the shipped config; the entrypoint renders config.xml from it and the environment.
# .build-id (written by the build stage) changes with every server build; the entrypoint then installs the card database
# built with the image (cards-prebuilt). xmage.jsa is a class-data archive recorded from one start of this server: with
# it the JVM maps the classes it would otherwise load and verify one by one, so the server starts with less CPU.
RUN sed -i "s/\r$//" /usr/local/bin/xmage-server /usr/local/bin/xmage-backup \
 && chmod +x /usr/local/bin/xmage-server /usr/local/bin/xmage-backup \
 && cp config/config.xml config/config.template.xml \
 && mkdir -p db && cp cards-prebuilt/cards.h2.mv.db db/ \
 && java $([ "$JAVA_RUNTIME" -ge 25 ] && echo -XX:+UseCompactObjectHeaders) \
      -XX:ArchiveClassesAtExit=/opt/xmage/xmage.jsa -Dxmage.exitAfterStartup=true -Dxmage.testMode=false \
      -Dxmage.healthPort=0 -Dxmage.replays=false -jar lib/mage-server-*.jar \
 && rm -rf db saved extensions mageserver.log \
 && useradd --system --home /opt/xmage xmage \
 && mkdir -p db cards-db logs saved /backups \
 && chown -R xmage /opt/xmage /backups
USER xmage
# 17172: web clients (behind the proxy). 17171 is the desktop client's port; publish it only if you want desktop players.
EXPOSE 17172
# db: user data. cards-db: card database cache. logs: mageserver.log. saved: saved games.
VOLUME ["/opt/xmage/db", "/opt/xmage/cards-db", "/opt/xmage/logs", "/opt/xmage/saved"]
ENTRYPOINT ["xmage-server"]
