# The web client, built and served by Caddy (automatic HTTPS), which also proxies /ws to the XMage server and /img to
# the Scryfall image cache.
# Build context: the repository root.  docker build -f ops/web/Dockerfile.web .
ARG CADDY_VERSION=2.11.7

FROM node:22-alpine AS build
WORKDIR /app
COPY Mage.Web.Client/package.json Mage.Web.Client/package-lock.json ./
RUN npm ci
COPY Mage.Web.Client/ ./
# card pictures and Scryfall lookups go through the imgcache service (Caddy routes /img to it);
# build with --build-arg VITE_IMAGE_PROXY= to talk to Scryfall directly
ARG VITE_IMAGE_PROXY=/img
ENV VITE_IMAGE_PROXY=${VITE_IMAGE_PROXY}
# the product name shown in the app and the page title
ARG VITE_APP_NAME=Playmat
ENV VITE_APP_NAME=${VITE_APP_NAME}
RUN npm run build

# Caddy with the per-address rate limit module, pinned to a known commit (2026-06-12)
FROM caddy:${CADDY_VERSION}-builder-alpine AS caddy
RUN xcaddy build --with github.com/mholt/caddy-ratelimit@5625512f24f6f59d6f64fb3aafe5eecff0b286db

FROM caddy:${CADDY_VERSION}-alpine
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY --from=build /app/dist /srv
COPY ops/web/Caddyfile /etc/caddy/Caddyfile
