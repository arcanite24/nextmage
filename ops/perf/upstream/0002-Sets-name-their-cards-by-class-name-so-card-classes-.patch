From beecec80f1e99ca258db4f644f2d62642731bd7f Mon Sep 17 00:00:00 2001
From: arcanite24 <arcaniteamp@gmail.com>
Date: Mon, 12 Oct 2026 16:36:58 -0600
Subject: [PATCH 02/10] Sets name their cards by class name, so card classes
 load on first use instead of at startup

---
 Mage.Sets/build/LazyCardClasses.java          | 65 +++++++++++++++++++
 Mage.Sets/pom.xml                             | 52 +++++++++++++++
 .../main/java/mage/cards/ExpansionSet.java    | 47 +++++++++++++-
 3 files changed, 161 insertions(+), 3 deletions(-)
 create mode 100644 Mage.Sets/build/LazyCardClasses.java

diff --git a/Mage.Sets/build/LazyCardClasses.java b/Mage.Sets/build/LazyCardClasses.java
new file mode 100644
index 0000000000..c7b9e4b8d6
--- /dev/null
+++ b/Mage.Sets/build/LazyCardClasses.java
@@ -0,0 +1,65 @@
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.DirectoryStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Build step for Mage.Sets (runs with "java LazyCardClasses.java", JDK 11 or later):
+ * copies the set sources to a generated folder with each card's class literal written as its class name,
+ * {@code mage.cards.a.Abc.class} becoming {@code "mage.cards.a.Abc"}. A set then names its cards without loading
+ * them, and a card's class loads the first time the card is made, so a server no longer loads every one of the
+ * ~30,000 card classes at startup. The sets in src stay exactly as upstream writes them.
+ *
+ * Usage: java LazyCardClasses.java <set sources> <output folder>
+ */
+public class LazyCardClasses {
+
+    private static final Pattern CARD_CLASS = Pattern.compile("\\b(mage\\.cards\\.[a-z0-9]+\\.[A-Za-z0-9_]+)\\.class\\b");
+
+    public static void main(String[] args) throws IOException {
+        Path source = Paths.get(args[0]);
+        Path output = Paths.get(args[1]);
+        Files.createDirectories(output);
+        Set<String> names = new HashSet<>();
+        int written = 0;
+        int literals = 0;
+        try (DirectoryStream<Path> sets = Files.newDirectoryStream(source, "*.java")) {
+            for (Path set : sets) {
+                String name = set.getFileName().toString();
+                names.add(name);
+                String text = new String(Files.readAllBytes(set), StandardCharsets.UTF_8);
+                Matcher matcher = CARD_CLASS.matcher(text);
+                StringBuffer lazy = new StringBuffer(text.length());
+                while (matcher.find()) {
+                    matcher.appendReplacement(lazy, "\"$1\"");
+                    literals++;
+                }
+                matcher.appendTail(lazy);
+                byte[] bytes = lazy.toString().getBytes(StandardCharsets.UTF_8);
+                Path target = output.resolve(name);
+                // rewrite only what changed, so the compiler's stale-source check still works
+                if (!Files.exists(target) || !java.util.Arrays.equals(Files.readAllBytes(target), bytes)) {
+                    Files.write(target, bytes);
+                    written++;
+                }
+            }
+        }
+        int removed = 0;
+        try (DirectoryStream<Path> generated = Files.newDirectoryStream(output, "*.java")) {
+            for (Path file : generated) {
+                if (!names.contains(file.getFileName().toString())) {
+                    Files.delete(file);
+                    removed++;
+                }
+            }
+        }
+        System.out.println("LazyCardClasses: " + names.size() + " sets, " + literals + " card classes named lazily, "
+                + written + " files written, " + removed + " removed");
+    }
+}
diff --git a/Mage.Sets/pom.xml b/Mage.Sets/pom.xml
index 8b7325f5c5..080f373afa 100644
--- a/Mage.Sets/pom.xml
+++ b/Mage.Sets/pom.xml
@@ -25,6 +25,58 @@
 
     <build>
         <sourceDirectory>src</sourceDirectory>
+        <plugins>
+            <!-- Lazy card classes: the sets are compiled from a generated copy that names each card's class as a
+                 string instead of a class literal (build/LazyCardClasses.java), so a server loads a card's class when
+                 the card is first made instead of all ~30,000 at startup. src/mage/sets stays as upstream writes it. -->
+            <plugin>
+                <groupId>org.codehaus.mojo</groupId>
+                <artifactId>exec-maven-plugin</artifactId>
+                <executions>
+                    <execution>
+                        <id>lazy-card-classes</id>
+                        <phase>generate-sources</phase>
+                        <goals>
+                            <goal>exec</goal>
+                        </goals>
+                        <configuration>
+                            <executable>${java.home}/bin/java</executable>
+                            <arguments>
+                                <argument>${project.basedir}/build/LazyCardClasses.java</argument>
+                                <argument>${project.basedir}/src/mage/sets</argument>
+                                <argument>${project.build.directory}/generated-sources/lazy-sets/mage/sets</argument>
+                            </arguments>
+                        </configuration>
+                    </execution>
+                </executions>
+            </plugin>
+            <plugin>
+                <groupId>org.apache.maven.plugins</groupId>
+                <artifactId>maven-compiler-plugin</artifactId>
+                <executions>
+                    <execution>
+                        <id>default-compile</id>
+                        <configuration>
+                            <excludes>
+                                <exclude>mage/sets/**</exclude>
+                            </excludes>
+                        </configuration>
+                    </execution>
+                    <execution>
+                        <id>compile-lazy-sets</id>
+                        <phase>compile</phase>
+                        <goals>
+                            <goal>compile</goal>
+                        </goals>
+                        <configuration>
+                            <compileSourceRoots>
+                                <compileSourceRoot>${project.build.directory}/generated-sources/lazy-sets</compileSourceRoot>
+                            </compileSourceRoots>
+                        </configuration>
+                    </execution>
+                </executions>
+            </plugin>
+        </plugins>
     </build>
 
     <properties>
