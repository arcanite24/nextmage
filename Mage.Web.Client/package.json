{
  "name": "mage-web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd ../Mage.Server/release && mvn -f ../../pom.xml -pl Mage.Server -am -DskipTests install && mvn -f ../../pom.xml -pl Mage.Server -Dexec.mainClass=mage.server.Main -Dexec.cleanupDaemonThreads=false exec:java",
    "dev:all": "bash scripts/dev-with-server.sh",
    "dev:kill": "bash scripts/kill-dev-servers.sh",
    "build": "tsc -b && vite build",
    "test": "npm run test:callbacks && npm run test:a11y",
    "test:callbacks": "tsc -p tsconfig.test.json && node --test .tmp/callback-tests/services/*.test.js",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "test:e2e": "playwright test e2e",
    "test:e2e:local": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-*.spec.ts --workers=1",
    "test:e2e:local:foundation": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-foundation.spec.ts --workers=1",
    "test:e2e:local:session-restore": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-session-restore.spec.ts --workers=1",
    "test:e2e:local:normal-match": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-normal-match.spec.ts --workers=1",
    "test:e2e:local:replay-watch": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-sideboard-watch-replay.spec.ts --workers=1",
    "test:e2e:local:tournament": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-tournament.spec.ts --workers=1",
    "test:e2e:local:draft": "MAGE_E2E_REQUIRE_SERVER=1 playwright test e2e/local-server-draft.spec.ts --workers=1",
    "test:visual": "playwright test visual",
    "test:visual:update": "playwright test visual --update-snapshots",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "framer-motion": "^12.27.5",
    "immer": "^11.1.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
